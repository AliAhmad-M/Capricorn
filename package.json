{
  "name": "capricorn",
  "version": "0.2.0",
  "author": "Ali Ahmad",
  "description": "A desktop assistant.",
  "main": "src/js/main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@msgpack/msgpack": "^3.1.3",
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.9",
    "groq-sdk": "^1.6.0",
    "ws": "^8.22.2"
  },
  "build": {
    "appId": "com.ali.capricorn",
    "productName": "Capricorn",
    "files": [
      "**/*",
      "!.env",
      "!settings.json"
    ],
    "win": {
      "target": "portable",
      "icon": "app-icon.ico"
    }
  }
}
